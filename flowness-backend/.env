# Copiá este archivo como .env y completá los valores.
# NUNCA subas el archivo .env a GitHub.

PORT=3000

# URL del frontend (para CORS y para las URLs de retorno de Mercado Pago).
# Podés poner varias separadas por coma, la primera es la principal.
# Ejemplo: https://flowness.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

BACKEND_URL=http://localhost:3000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:fldeco@localhost:5432/flowness"

# Clave para firmar los tokens JWT. Generala con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
