generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USUARIOS Y AUTENTICACIÓN
// ─────────────────────────────────────────────

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(USUARIO)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  compras   Compra[]
  resenas   Resena[]
}

enum Rol {
  ADMIN
  USUARIO
}

// ─────────────────────────────────────────────
// CONFIGURACIÓN EDITABLE DEL SITIO
// claves: hero_titulo, hero_subtitulo, hero_descripcion,
//         instagram_url, whatsapp_numero, popup_texto, popup_instagram
// ─────────────────────────────────────────────

model Configuracion {
  id          Int      @id @default(autoincrement())
  clave       String   @unique
  valor       String
  actualizadoEn DateTime @updatedAt
}

// ─────────────────────────────────────────────
// FASES DEL MÉTODO
// Las 6 fases son categorías del método de Flowness
// Cada fase tiene un video corto de muestra
// ─────────────────────────────────────────────

model Fase {
  id          Int      @id @default(autoincrement())
  numero      Int      @unique
  nombre      String
  descripcion String
  videoUrl    String?
  muestraUrl  String?  // video corto (10-20 s) que se reproduce solo, sin sonido, en la tarjeta
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  clases      Clase[]
}

// ─────────────────────────────────────────────
// CLASES
// Videos sueltos para todo público. Se compran de a una.
// Las marcadas como gratis se ven con solo registrarse.
// El video es un link de YouTube "No listado": el link solo
// se entrega a quien tiene acceso a la clase.
// (faseId queda opcional por compatibilidad: las fases ahora
// son solo texto explicativo y ya no agrupan clases)
// ─────────────────────────────────────────────

model Clase {
  id           Int      @id @default(autoincrement())
  faseId       Int?
  nombre       String
  descripcion  String
  videoUrl     String?
  miniaturaUrl String?
  muestraUrl   String?  // video corto de muestra para la tarjeta (no es la clase completa)
  duracion     String?
  precio       Float    @default(0)
  esGratis     Boolean  @default(false)
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  fase        Fase?       @relation(fields: [faseId], references: [id])
  compras     Compra[]
  documentos  Documento[]
  resenas     Resena[]
}

// ─────────────────────────────────────────────
// FORMACIÓN (cursos para profesionales)
// 3 niveles: Esencial, Avanza y Pro. Cada nivel se compra por separado.
// Quien compra un curso ve todas sus lecciones publicadas, también las
// que Florencia suba después. totalVideos es la cantidad prevista:
// las que faltan se muestran como "Próximamente".
// ─────────────────────────────────────────────

model Curso {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  nombre      String
  subtitulo   String?
  descripcion String   @default("")
  dirigidoA   String?
  duracion    String?
  totalVideos Int?
  precio      Float    @default(0)
  portadaUrl  String?
  muestraUrl  String?  // video corto de muestra para la tarjeta del nivel
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  lecciones   Leccion[]
  compras     Compra[]
  resenas     Resena[]
}

// Cada lección: un video de YouTube "No listado" + su PDF explicativo
model Leccion {
  id          Int      @id @default(autoincrement())
  cursoId     Int
  titulo      String
  descripcion String?
  videoUrl    String?
  pdfUrl      String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  curso       Curso    @relation(fields: [cursoId], references: [id])
}

// ─────────────────────────────────────────────
// COMPRAS
// Una compra es de una clase (claseId) o de un curso (cursoId).
// ─────────────────────────────────────────────

model Compra {
  id            Int        @id @default(autoincrement())
  usuarioId     Int
  claseId       Int?
  cursoId       Int?
  monto         Float
  estado        EstadoPago @default(PENDIENTE)
  mpPagoId      String?
  creadoEn      DateTime   @default(now())

  usuario       Usuario    @relation(fields: [usuarioId], references: [id])
  clase         Clase?     @relation(fields: [claseId], references: [id])
  curso         Curso?     @relation(fields: [cursoId], references: [id])
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ─────────────────────────────────────────────
// DOCUMENTOS (PDFs adjuntos a clases)
// ─────────────────────────────────────────────

model Documento {
  id          Int      @id @default(autoincrement())
  claseId     Int
  titulo      String
  descripcion String?
  url         String
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  clase       Clase    @relation(fields: [claseId], references: [id])
}

// ─────────────────────────────────────────────
// GALERÍA DE FOTOS
// ─────────────────────────────────────────────

model Foto {
  id          Int      @id @default(autoincrement())
  tipo        String   @default("ARCHIVO") // ARCHIVO (subida a Cloudinary) o INSTAGRAM (link de una publicación)
  url         String
  enlace      String?  // link de la publicación de Instagram, si vino de ahí
  descripcion String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
}

// Videos cortos (reels) de la galería. Pueden venir de dos lados:
// - INSTAGRAM: link a un reel público de Instagram (no ocupa espacio).
// - ARCHIVO: video subido desde la compu o el celular a Cloudinary.
model Reel {
  id          Int      @id @default(autoincrement())
  tipo        String   @default("INSTAGRAM")
  url         String
  enlace      String?  // link de la publicación de Instagram, si vino de ahí
  descripcion String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
}

// ─────────────────────────────────────────────
// SOBRE MÍ (info de la instructora)
// ─────────────────────────────────────────────

model SobreMi {
  id            Int      @id @default(autoincrement())
  nombre        String
  titulo        String
  descripcion1  String
  descripcion2  String
  fotoUrl       String?
  videoUrl      String?  // video de la historia (YouTube o subido). Si hay video, se muestra en vez de la foto
  actualizadoEn DateTime @updatedAt
}

// ─────────────────────────────────────────────
// AVISOS
// ─────────────────────────────────────────────

model Aviso {
  id          Int      @id @default(autoincrement())
  tipo        String   @default("NOVEDAD") // NOVEDAD | CLASE_GRATIS | PROMO
  titulo      String
  descripcion String
  destino     String   @default("")        // botón: "" | clases | formacion | whatsapp | link
  enlace      String?                      // solo si destino = link
  imagenUrl   String?                      // imagen opcional (Cloudinary)
  hasta       String?                      // AAAA-MM-DD: último día que se muestra (opcional)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
}

// ─────────────────────────────────────────────
// RESEÑAS
// Solo opina quien tiene acceso (compró la clase o el curso, o la clase es
// gratis). Cada persona deja una sola reseña por clase o curso. Se ven en el
// sitio recién cuando Florencia la aprueba. "destacada" = aparece en el Inicio.
// ─────────────────────────────────────────────

model Resena {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  claseId       Int?
  cursoId       Int?
  estrellas     Int                          // de 1 a 5
  texto         String   @default("")
  estado        String   @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA
  respuesta     String?                      // respuesta pública de Florencia
  destacada     Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clase         Clase?   @relation(fields: [claseId], references: [id], onDelete: Cascade)
  curso         Curso?   @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, claseId])
  @@unique([usuarioId, cursoId])
  @@index([estado])
}
