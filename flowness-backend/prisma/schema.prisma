generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USUARIOS Y AUTENTICACIÓN
// ─────────────────────────────────────────────

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(USUARIO)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  compras   Compra[]
}

enum Rol {
  ADMIN
  USUARIO
}

// ─────────────────────────────────────────────
// CONFIGURACIÓN EDITABLE DEL SITIO
// claves: hero_titulo, hero_subtitulo, hero_descripcion,
//         instagram_url, whatsapp_numero, popup_texto, popup_instagram
// ─────────────────────────────────────────────

model Configuracion {
  id          Int      @id @default(autoincrement())
  clave       String   @unique
  valor       String
  actualizadoEn DateTime @updatedAt
}

// ─────────────────────────────────────────────
// FASES DEL MÉTODO
// Las 6 fases son categorías del método de Flowness
// Cada fase tiene un video corto de muestra
// ─────────────────────────────────────────────

model Fase {
  id          Int      @id @default(autoincrement())
  numero      Int      @unique
  nombre      String
  descripcion String
  videoUrl    String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  clases      Clase[]
}

// ─────────────────────────────────────────────
// CLASES
// Videos sueltos para todo público. Se compran de a una.
// Las marcadas como gratis se ven con solo registrarse.
// El video es un link de YouTube "No listado": el link solo
// se entrega a quien tiene acceso a la clase.
// (faseId queda opcional por compatibilidad: las fases ahora
// son solo texto explicativo y ya no agrupan clases)
// ─────────────────────────────────────────────

model Clase {
  id           Int      @id @default(autoincrement())
  faseId       Int?
  nombre       String
  descripcion  String
  videoUrl     String?
  miniaturaUrl String?
  duracion     String?
  precio       Float    @default(0)
  esGratis     Boolean  @default(false)
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  fase        Fase?       @relation(fields: [faseId], references: [id])
  compras     Compra[]
  documentos  Documento[]
}

// ─────────────────────────────────────────────
// FORMACIÓN (cursos para profesionales)
// 3 niveles: Esencial, Avanza y Pro. Cada nivel se compra por separado.
// Quien compra un curso ve todas sus lecciones publicadas, también las
// que Florencia suba después. totalVideos es la cantidad prevista:
// las que faltan se muestran como "Próximamente".
// ─────────────────────────────────────────────

model Curso {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  nombre      String
  subtitulo   String?
  descripcion String   @default("")
  dirigidoA   String?
  duracion    String?
  totalVideos Int?
  precio      Float    @default(0)
  portadaUrl  String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  lecciones   Leccion[]
  compras     Compra[]
}

// Cada lección: un video de YouTube "No listado" + su PDF explicativo
model Leccion {
  id          Int      @id @default(autoincrement())
  cursoId     Int
  titulo      String
  descripcion String?
  videoUrl    String?
  pdfUrl      String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  curso       Curso    @relation(fields: [cursoId], references: [id])
}

// ─────────────────────────────────────────────
// COMPRAS
// Una compra es de una clase (claseId) o de un curso (cursoId).
// ─────────────────────────────────────────────

model Compra {
  id            Int        @id @default(autoincrement())
  usuarioId     Int
  claseId       Int?
  cursoId       Int?
  monto         Float
  estado        EstadoPago @default(PENDIENTE)
  mpPagoId      String?
  creadoEn      DateTime   @default(now())

  usuario       Usuario    @relation(fields: [usuarioId], references: [id])
  clase         Clase?     @relation(fields: [claseId], references: [id])
  curso         Curso?     @relation(fields: [cursoId], references: [id])
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ─────────────────────────────────────────────
// DOCUMENTOS (PDFs adjuntos a clases)
// ─────────────────────────────────────────────

model Documento {
  id          Int      @id @default(autoincrement())
  claseId     Int
  titulo      String
  descripcion String?
  url         String
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  clase       Clase    @relation(fields: [claseId], references: [id])
}

// ─────────────────────────────────────────────
// GALERÍA DE FOTOS
// ─────────────────────────────────────────────

model Foto {
  id          Int      @id @default(autoincrement())
  url         String
  descripcion String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
}

// Videos cortos (reels) de la galería. Pueden venir de dos lados:
// - INSTAGRAM: link a un reel público de Instagram (no ocupa espacio).
// - ARCHIVO: video subido desde la compu o el celular a Cloudinary.
model Reel {
  id          Int      @id @default(autoincrement())
  tipo        String   @default("INSTAGRAM")
  url         String
  descripcion String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
}

// ─────────────────────────────────────────────
// SOBRE MÍ (info de la instructora)
// ─────────────────────────────────────────────

model SobreMi {
  id            Int      @id @default(autoincrement())
  nombre        String
  titulo        String
  descripcion1  String
  descripcion2  String
  fotoUrl       String?
  actualizadoEn DateTime @updatedAt
}

// ─────────────────────────────────────────────
// AVISOS
// ─────────────────────────────────────────────

model Aviso {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
}
